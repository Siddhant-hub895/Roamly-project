<% layout("/layouts/boilerplate") %>
<div class="row">
    <div class="col-8 offset-2">
<body>
    <h3>Edit the listings</h3>

    <hr>

    <form method="POST" action="/listings/<%= listing._id%>?_method=PUT" novalidate class="needs-validation" enctype="multipart/form-data">

        <div class="mb-3">
            <label for="title" class="form-label"><b>Title</b></label>
            <input name="listing[title]" class="form-control" value="<%= listing.title%>" type="text" required>
            <div class="valid-feedback">Title looks good!</div>
        </div>
        
        <div class="mb-3">
            <label for="description" class="form-label"><b>Description</b></label>
            <textarea name="listing[description]" class="form-control" cols="10" rows="5" required><%= listing.description%></textarea>
            <div class="invalid-feedback">add short description</div>
        </div>
        
        <div class="mb-3">
            <label for="price" class="form-label"><b>Price</b></label>
            <input name="listing[price]" class="form-control" value="<%= listing.price%>"  type="number" required>
            <div class="invalid-feedback">price should be valid</div>
        </div>

        <div class="mb-3">
            <label for="img" class="form-label"><b>Upload New Image</b></label>
            <input name="listing[image]" class="form-control" type="file" >
        </div>
        
        <div class="row">
            <div class="mb-3 col-md-8">
                <label for="location" class="form-label"><b>Location</b></label>
                <input name="listing[location]" class="form-control" value="<%= listing.location%>" type="text" required>
                <div class="invalid-feedback">location should be valid</div>
            </div>
        
            <div class="mb-3 col-md-4">
               <label for="country" class="form-label"><b>Country</b></label>
               <input name="listing[country]" class="form-control" value="<%= listing.country%>" type="text" required>
               <div class="invalid-feedback">country should be valid</div>
            </div>
        </div>
        

        <button class="btn btn-dark add-btn">update</button>
    </form>


    <hr>
</body>
</div>
</div>