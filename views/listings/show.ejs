<% layout("/layouts/boilerplate") -%>

<script>
  const mapToken = "<%= process.env.MAP_TOKEN%>";
  const listing = <%- JSON.stringify(listing)%>;
</script>
<div class="row mt-3">
    <div class="col-8 offset-2">
<body>
    <!-- <h3>Details</h3> -->

    <div class="card col-6 offset-2 listing-card">
      <b><%= listing.title%></b>
        <img src="<%= listing.image.url%>" class="img" alt="listing image">
        <div class="card-body">
          <p>Owned by:<i><%= listing.owner.username%></i></p>
          <p class="card-text">
            <%= listing.description%><br>
            &#8377; <%= listing.price.toLocaleString("em-IN")%><br>
            <%= listing.location%><br>
            <%= listing.country%>
          </p>
        </div>
    </div>
        
       <%if(currUser && currUser._id.equals(listing.owner.id)){%>
        <div class="btns">
            <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark add-btn">Edit</a>
           <br>
            <form method="POST" action="/listings/<%= listing._id%>?_method=DELETE">
              <button class="btn btn-dark del-btn">Delete !</button>
            </form>
        </div>
        <%}%>
        
        
        <hr>
        <div class="col-8 offset-2">
          <%if(currUser){%>
          <h5>Leave a review</h5>
          <form action="/listings/<%= listing.id%>/reviews" 
            method="post"
            novalidate
            class="needs-validation">

            <div class="mb-3 mt-3">
              <label for="rating" class="form-label">Rating</label>
              <fieldset class="starability-slot">
                <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                <label for="first-rate1" title="Terrible">1 star</label>
                <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                <label for="first-rate2" title="Not good">2 stars</label>
                <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                <label for="first-rate3" title="Average">3 stars</label>
                <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                <label for="first-rate4" title="Very good">4 stars</label>
                <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                <label for="first-rate5" title="Amazing">5 stars</label>
              </fieldset>
            </div>

            <div  class="mb-3 mt-3">
              <label for="comment" class="form-label">Comment</label>
              <textarea id="comment" name="review[comment]" 
              rows="5" cols="15" placeholder="Write here.." 
              class="form-control" required></textarea>
              <div class="invalid-feedback">
                 Please add some comment for review.
              </div>
            </div>
            <button class="btn btn-outline-dark">submit</button>
          </form>
          <hr>
          <%}%>
        </div>

          <% if(listing.reviews.length > 0) {%>
          <ul>
            <div class="row">
            <b><p>All Reviews</p></b>
            <% for(review of listing.reviews) {%>
              <div class="card col-5  mb-2 ms-2">
                <h5 class="card-title"><b>@<%= review.author.username%></b></h5>
                <p class="starability-result" data-rating="<%= review.rating%>"></p>
                <p class="card-text"><%= review.comment%></p>
                <form class="mb-3"
                method="post"
                action="/listings/<%= listing._id%>/reviews/<%= review._id%>?_method=DELETE">
                  <button class="btn btn-outline-dark btn-sm">Delete</button>
                </form>
              </div>
            <% } %>
            </div>
          </ul>
          <hr>
          <% } %>
</body>
</div>
        <div class="col-8 offset-3 mb-3">
          <h5>Where you'll be</h5>
          <div id="map"></div>
        </div>
</div>

<script src="/js/map.js"></script>